# Database (Neon)
DATABASE_URL=postgresql://user:password@hostname/database?sslmode=require

# Cloudflare R2 (Para Fase 4)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/record
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/record

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cron Jobs
CRON_SECRET=your-cron-secret-here

# Transcoding Pipeline (Streaming Upload + Server-Side Transcode)
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=your-internal-api-secret-here
# Optional: external transcode worker URL (leave empty to use Vercel Background Functions)
TRANSCODE_BACKEND_URL=

# App URL (used for internal API calls in production)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
